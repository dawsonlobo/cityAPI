{
    "version": "0.2",
    "language": "en",
    "ignorePaths": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "**/*.min.js",
      "**/vendor/**"
    ],
    "words": [
      "GraphQL",
      "TypeScript",
      "cspell",
      "MyCustomTerm"
    ],
    "ignoreWords": [
      "foobarbaz",
      "testword",
      "Karnataka",
      "Bengaluru",
      "codepaths",
      "refreshtokens",
      "accesstokens"
    ],
    "allowCompoundWords": true
  }
  